{
  "name": "payzum/payzum-php",
  "description": "Official PHP SDK for the Payzum crypto payment API — accept stablecoin and crypto payments, verify IPN webhooks.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://merchant.payzum.com",
  "keywords": [
    "payzum",
    "payments",
    "crypto",
    "stablecoin",
    "usdt",
    "usdc",
    "payment-gateway",
    "bitcoin",
    "ethereum"
  ],
  "authors": [
    {
      "name": "Payzum",
      "homepage": "https://payzum.com"
    }
  ],
  "support": {
    "docs": "https://merchant.payzum.com/docs",
    "issues": "https://github.com/payzumhq/payzum-php/issues",
    "source": "https://github.com/payzumhq/payzum-php"
  },
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Payzum\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
